# Copy this file to .env and fill in. NEVER commit .env to GitHub.
# Any OpenAI-compatible chat API works. Many have a free tier (Groq, OpenRouter, etc.).
# Free tiers have rate limits; check the provider's current terms.
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=llama-3.1-8b-instant

# Optional
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# GW_DATA_DIR=./data
# GW_VECTOR_DIR=./vector_store
